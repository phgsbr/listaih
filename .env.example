# Listaih — Docker Compose Environment
# Copy this file to .env and adjust values

# PostgreSQL
POSTGRES_PASSWORD=listaih

# JWT
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Backend
BACKEND_PORT=3000
CORS_ORIGIN=*

# OAuth2 (optional — for future Google/Apple Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
